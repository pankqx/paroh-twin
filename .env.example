# Server-side OpenRouter credentials and model selection. Keep real keys in .env.local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Optional OpenAI-compatible API base (default: https://openrouter.ai/api/v1).
# For local Ollama, set e.g. http://localhost:11434/v1 and set OPENROUTER_MODEL to its model name.
LLM_BASE_URL=

# Optional: persistent visit counter. Leave empty to use the free keyless counterapi.dev counter.
# For a Redis-backed count, add Upstash Redis from the Vercel Marketplace (it sets KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISIT_COUNTER_NAMESPACE=
