# Server-side OpenRouter credentials and model selection. Keep real keys in .env.local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Optional OpenAI-compatible API base (default: https://openrouter.ai/api/v1).
# For local Ollama, set e.g. http://localhost:11434/v1 and set OPENROUTER_MODEL to its model name.
LLM_BASE_URL=
